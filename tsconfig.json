{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": { "@gears/ui": ["./src/index.ts"] }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "preview/**/*.ts", "preview/**/*.vue"]
}
