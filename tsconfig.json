{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "paths": {
      "@ternarytech-io/gears-ui": [
        "./src/index.ts"
      ],
      "@ternarytech-io/gears-ui/plugins": [
        "./src/plugins/index.ts"
      ],
      "@ternarytech-io/gears-ui/code-editor": [
        "./src/code-editor.ts"
      ]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "preview/**/*.ts",
    "preview/**/*.vue"
  ]
}
